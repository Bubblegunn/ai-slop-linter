{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ai-slop-linter: lint Markdown",
      "detail": "Findings land in the Problems panel and inline, through the problem matcher below. Copy this task into your own .vscode/tasks.json.",
      "type": "shell",
      "command": "npx",
      "args": ["--yes", "ai-slop-linter", "--warn"],
      "group": "test",
      "presentation": { "reveal": "silent", "clear": true },
      "problemMatcher": {
        "owner": "ai-slop-linter",
        "source": "ai-slop-linter",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": [
          {
            "regexp": "^(\\S.*?)  [A-F] \\(score .*\\)$",
            "file": 1
          },
          {
            "regexp": "^\\s+(\\d+):(\\d+)\\s+(error|warning|info)\\s+(\\S+)\\s+(.*)$",
            "line": 1,
            "column": 2,
            "severity": 3,
            "code": 4,
            "message": 5,
            "loop": true
          }
        ]
      }
    }
  ]
}
